# Gebaute Plugin-Pakete (zentral; gitpush kann mit -f trotzdem hinzufügen)
releases/**/*.tar.gz
!releases/**/.gitkeep

# Credentials und lokale Konfigurationen
.vscode/woltlab-credentials.local.json
*.local.json
.env.local
.env
tools/.woltlab-setup-state
tools/.woltlab-setup-state.json
tools/manager-push.sh
tools/manager-push.env
tools/docs/logs/

# MkDocs build output
site/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Vale (Linter-Konfiguration/Cache – nur lokal)
.vale/
.vale.ini

# Temporary files
*.tmp
*.bak
*.backup
*.old

# Produktlinie: lokale Staging-/Manifest-Dateien (nicht committen)
_family-stage/
/swpm-family.shrinkr.json
/swpm-family.local.json
tools/.woltlab-setup-done

# Copywriting tool (Python venv + cache)
tools/copywriting/.venv/
tools/copywriting/**/__pycache__/
tools/**/__pycache__/

# Portable Runtimes (PHP, MariaDB, Node – werden von download-runtimes.sh befüllt)
tools/runtime/php/
tools/runtime/mariadb/
tools/runtime/node/
tools/runtime/.pid.*
tools/runtime/.pids

# DDEV (nur generierte Dateien ignorieren)
woltlab-dev/.ddev/.ddev-docker-compose-*
woltlab-dev/.ddev/import.yaml
woltlab-dev/.ddev/docker-compose.yaml
woltlab-dev/.ddev/.gitignore
# WICHTIG: Verzeichnis bleibt erhalten, aber INHALT wird ignoriert
tools/woltlab-dev/public/*
!tools/woltlab-dev/public/.gitignore
!tools/woltlab-dev/public/README*.md

# WICHTIG: Diese Ordner nur als leere Platzhalter (nur .gitkeep). Inhalt wird nicht hochgeladen.
# WoltLab Core (download-woltlab-core.sh)
woltlab-core/*
!woltlab-core/.gitkeep

# WoltLab Docs (setup-minimal.sh klont hier rein)
woltlab-docs/*
!woltlab-docs/.gitkeep

# WoltLab GitHub/WCF (setup-minimal.sh klont hier rein)
woltlab-github/*
!woltlab-github/.gitkeep

# WoltLab TypeScript d.ts (setup-minimal.sh klont hier rein)
woltlab-d-ts/*
!woltlab-d-ts/.gitkeep

# Plugin-Verzeichnisse (werden separat verwaltet, NICHT committen!)
# WICHTIG: Verzeichnisse bleiben erhalten, aber INHALT wird ignoriert
# Diese enthalten große Dateien und werden separat gebaut/verwaltet
basis-plugin/*
!basis-plugin/.gitignore
!basis-plugin/README*.md
!basis-plugin/CHANGELOG*.md

mein-plugin/*
!mein-plugin/.gitignore
!mein-plugin/README*.md
!mein-plugin/CHANGELOG*.md

plugins-integrieren/*
!plugins-integrieren/.gitignore
!plugins-integrieren/README*.md
!plugins-integrieren/CHANGELOG*.md
.venv-docs/
