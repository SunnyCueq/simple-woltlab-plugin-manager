{"name":"woltlab-build-button","displayName":"WoltLab Build Button","description":"Build-Button und Tools-Menü in der Seitenleiste für WoltLab Plugin Build","version":"0.3.0","engines":{"vscode":"^1.74.0"},"categories":["Other"],"activationEvents":["onStartupFinished"],"main":"./extension.js","contributes":{"configuration":{"title":"WoltLab Development","properties":{"woltlabDevelopment.toolsRoot":{"type":"string","default":"","description":"Absoluter Pfad zum WoltLab-Entwicklungs-Root (Ordner, in dem tools.sh liegt). Leer = automatische Erkennung über Workspace."}}},"commands":[{"command":"woltlabBuild.run","title":"WoltLab Build (Patch)","icon":"$(run-all)"},{"command":"woltlabBuild.runTool1","title":"Build","icon":"$(run-all)"},{"command":"woltlabBuild.runTool2","title":"Git Push","icon":"$(repo-push)"},{"command":"woltlabBuild.runTool3","title":"TypeScript","icon":"$(file-code)"},{"command":"woltlabBuild.runTool4","title":"Unpack","icon":"$(package)"},{"command":"woltlabBuild.runTool5","title":"Hilfe & Dokumentation","icon":"$(book)"},{"command":"woltlabBuild.runTool6","title":"Plugin Validierung","icon":"$(check-all)"},{"command":"woltlabBuild.runToolManagerPush","title":"Manager Push (Maintainer)","icon":"$(cloud-upload)"},{"command":"woltlabBuild.runToolsMenu","title":"Tools-Menü öffnen","icon":"$(list-flat)"}],"viewsContainers":{"activitybar":[{"id":"woltlabBuild","title":"WoltLab","icon":"$(run-all)"}]},"views":{"woltlabBuild":[{"id":"woltlabBuildView","name":"Tools"}]}}}
