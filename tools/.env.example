# WoltLab Plugin Manager – Konfiguration
# Kopiere diese Datei zu .env und passe bei Bedarf an.
# Das minimale Setup (setup-minimal.sh) schreibt bzw. nutzt diese Werte.

# ============================================
# Setup (minimales Setup setzt diese Werte)
# ============================================
# Pfad zur lokalen WoltLab-Installation (z. B. /var/www/woltlab oder C:\xampp\htdocs\woltlab).
# Leer = nicht gesetzt. Wird im Setup optional abgefragt.
# WOLTLAB_PUBLIC_DIR=

# URLs für Clone (Standardwerte; im Setup verwendbar)
# WOLTLAB_DOCS_URL=https://github.com/WoltLab/docs.woltlab.com
# WOLTLAB_GITHUB_URL=https://github.com/WoltLab/WCF
# WoltLab TypeScript-Typings (d.ts), Standard: immer im Setup angeboten
# WOLTLAB_DTS_URL=https://github.com/WoltLab/d.ts
# WOLTLAB_DTS_DIR=woltlab-d-ts

# ============================================
# GitHub (optional, für Git Push / Releases)
# ============================================
# GITHUB_USERNAME=
# GITHUB_TOKEN=

# Git-Repository (origin) für diesen Workspace. Wird im Setup optional abgefragt.
# Für gitpush.sh, wenn noch kein origin gesetzt. Beispiele:
# GIT_REPO_URL=https://github.com/user/repo
# GIT_REPO_URL=git@github.com:user/repo.git
# GIT_REPO_URL=

# ============================================
# Copywriting-Review (tools/copywriting, optional)
# ============================================
# OPENAI_API_KEY=
# COPYWRITING_API_KEY=
# COPYWRITING_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# Sprache (Menü & Meldungen, sobald zweisprachig)
# ============================================
# de = Deutsch, en = Englisch. Wenn leer: wird aus LANG/LC_MESSAGES abgeleitet.
# WOLTLAB_LANG=de
# WOLTLAB_LANG=en

# ============================================
# Docker / lokaler Test-Container (optional)
# ============================================
# WOLTLAB_DOCKER_CONTAINER=woltlab-web
# WOLTLAB_PLUGIN_DIR=basis-plugin
# WOLTLAB_PACKAGE_ID=com.vendor.myapp
# WOLTLAB_APP_ABBREV=myapp
# WOLTLAB_EXTRA_CONTAINER_PATHS=/var/www/html/extra-dev.php

# ============================================
# Produktlinie (optional, Basis + Zusatzpakete)
# ============================================
# Pfad zu swpm-family.json (absolut oder relativ zum SWPM-Root).
# Leer = MAIN_DIR/swpm-family.json falls vorhanden.
# Bei family:* werden WOLTLAB_PACKAGE_ID / WOLTLAB_APP_ABBREV ignoriert.
# WOLTLAB_FAMILY_MANIFEST=swpm-family.json
# WOLTLAB_FAMILY_MANIFEST=../my-product/swpm-family.json
