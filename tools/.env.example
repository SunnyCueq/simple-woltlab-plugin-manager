# WoltLab Development Tools - Environment Configuration
# Kopiere diese Datei zu .env und passe die Werte an

# ============================================
# DDEV Konfiguration
# ============================================
DDEV_PROJECT_NAME=woltlab

# ============================================
# MySQL/Datenbank Konfiguration
# ============================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db
DB_USER=db
DB_PASSWORD=db

# ============================================
# phpMyAdmin (über DDEV)
# ============================================
# Keine zusätzliche Konfiguration nötig

# ============================================
# WoltLab Admin Konfiguration
# ============================================
WOLTLAB_ADMIN_USERNAME=Admin
WOLTLAB_ADMIN_EMAIL=admin@example.com
WOLTLAB_ADMIN_PASSWORD=123456
WOLTLAB_ADMIN_PASSWORD_CONFIRM=123456

# ============================================
# Portainer Konfiguration
# ============================================
PORTAINER_ENABLED=true
PORTAINER_NAME=portainer
PORTAINER_PORT=9000
PORTAINER_IMAGE=portainer/portainer-ce:latest
PORTAINER_DATA_VOLUME=portainer_data

# ============================================
# GitHub Konfiguration (optional)
# ============================================
# GITHUB_USERNAME=
# GITHUB_TOKEN=
