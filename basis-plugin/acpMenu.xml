<?xml version="1.0" encoding="UTF-8"?>
<!--
    Datei-Zweck: ACP-Menü-Registration für Shr1nkr Plugin
    
    Diese XML-Datei registriert ACP-Menüpunkte für das Shr1nkr Plugin.
    Definiert Hauptmenü und Untermenüs für URLs, Discounts, Descriptions,
    Themes, Custom Buttons, Featured Links, Specials und Statistiken.
    
    Struktur:
    - <import>: Importiert ACP-Menüpunkte für das Plugin
    - <acpmenuitem>: Definiert einzelne Menüpunkte mit Controller, Parent, Permissions, etc.
    
    Menüstruktur:
    - Hauptmenü: shrinkr.acp.menu.link.menu
      - URLs (Liste, Hinzufügen)
      - Discounts (Liste, Hinzufügen)
      - Descriptions (Liste, Hinzufügen)
      - Themes (Liste, Hinzufügen)
      - Custom Buttons (Liste, Hinzufügen)
      - Featured Links (Liste, Hinzufügen)
      - Specials (Liste, Hinzufügen)
      - Statistiken (Button Clicks)
    
    @author Sunny C
    @copyright 2026 Sunny C
    @package de.sunnyc.wsc.shrinkr
    @see https://sunnyc.de
-->
<data xmlns="http://www.woltlab.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.woltlab.com http://www.woltlab.com/XSD/6.0/acpMenu.xsd">
	<import>
		<acpmenuitem name="shrinkr.acp.menu.link.menu">
			<parent>wcf.acp.menu.link.application</parent>
			<options>shrinkr_active</options>
			<showorder>100</showorder>
		</acpmenuitem>
		<acpmenuitem name="shrinkr.acp.menu.link.link.list">
			<controller>shrinkr\acp\page\ShrinkrLinkListPage</controller>
			<parent>shrinkr.acp.menu.link.menu</parent>
			<options>shrinkr_active</options>
			<permissions>admin.shrinkr.canManageLinks</permissions>
			<showorder>1</showorder>
		</acpmenuitem>
		<acpmenuitem name="shrinkr.acp.menu.link.link.add">
			<controller>shrinkr\acp\form\ShrinkrLinkAddForm</controller>
			<parent>shrinkr.acp.menu.link.link.list</parent>
			<options>shrinkr_active</options>
			<permissions>admin.shrinkr.canManageLinks</permissions>
			<icon>plus</icon>
			<showorder>3</showorder>
		</acpmenuitem>

		<acpmenuitem name="shrinkr.acp.menu.link.discount.list">
			<controller>shrinkr\acp\page\DiscountListPage</controller>
			<parent>shrinkr.acp.menu.link.menu</parent>
			<options>shrinkr_active</options>
			<permissions>admin.shrinkr.canManageDiscounts</permissions>
			<showorder>2</showorder>
		</acpmenuitem>
		<acpmenuitem name="shrinkr.acp.menu.link.discount.add">
			<controller>shrinkr\acp\form\DiscountAddForm</controller>
			<parent>shrinkr.acp.menu.link.discount.list</parent>
			<options>shrinkr_active</options>
			<permissions>admin.shrinkr.canManageDiscounts</permissions>
			<icon>plus</icon>
			<showorder>1</showorder>
		</acpmenuitem>

		<acpmenuitem name="shrinkr.acp.menu.link.description.list">
			<controller>shrinkr\acp\page\DescriptionListPage</controller>
			<parent>shrinkr.acp.menu.link.menu</parent>
			<options>shrinkr_active</options>
			<permissions>admin.shrinkr.canManageDescriptions</permissions>
			<showorder>3</showorder>
		</acpmenuitem>
		<acpmenuitem name="shrinkr.acp.menu.link.description.add">
			<controller>shrinkr\acp\form\DescriptionAddForm</controller>
			<parent>shrinkr.acp.menu.link.description.list</parent>
			<options>shrinkr_active</options>
			<permissions>admin.shrinkr.canManageDescriptions</permissions>
			<icon>plus</icon>
			<showorder>1</showorder>
		</acpmenuitem>

		<acpmenuitem name="shrinkr.acp.menu.link.special.list">
			<controller>shrinkr\acp\page\SpecialListPage</controller>
			<parent>shrinkr.acp.menu.link.link.list</parent>
			<options>shrinkr_active</options>
			<permissions>admin.shrinkr.canManageSpecials</permissions>
			<icon>fire</icon>
			<showorder>1</showorder>
		</acpmenuitem>

		<acpmenuitem name="shrinkr.acp.menu.link.link.password">
			<controller>shrinkr\acp\page\ShrinkrLinkListPage</controller>
			<link>passwordProtected=1</link>
			<parent>shrinkr.acp.menu.link.link.list</parent>
			<options>shrinkr_active</options>
			<permissions>admin.shrinkr.canManageLinks</permissions>
			<icon>key</icon>
			<showorder>2</showorder>
		</acpmenuitem>

		<acpmenuitem name="shrinkr.acp.menu.link.theme.list">
			<controller>shrinkr\acp\page\ThemeListPage</controller>
			<parent>shrinkr.acp.menu.link.menu</parent>
			<options>shrinkr_active</options>
			<permissions>admin.shrinkr.canManageThemes</permissions>
			<showorder>7</showorder>
		</acpmenuitem>
		<acpmenuitem name="shrinkr.acp.menu.link.theme.add">
			<controller>shrinkr\acp\form\ThemeAddForm</controller>
			<parent>shrinkr.acp.menu.link.theme.list</parent>
			<options>shrinkr_active</options>
			<permissions>admin.shrinkr.canManageThemes</permissions>
			<icon>plus</icon>
			<showorder>1</showorder>
		</acpmenuitem>

		<acpmenuitem name="shrinkr.acp.menu.link.statistics.list">
			<controller>shrinkr\acp\page\ButtonClickListPage</controller>
			<parent>shrinkr.acp.menu.link.menu</parent>
			<options>shrinkr_active</options>
			<permissions>admin.shrinkr.canManageButtonClicks</permissions>
			<showorder>8</showorder>
		</acpmenuitem>

		<acpmenuitem name="shrinkr.acp.menu.link.settings">
			<controller>shrinkr\acp\form\ShrinkrSettingsForm</controller>
			<parent>shrinkr.acp.menu.link.menu</parent>
			<options>shrinkr_active</options>
			<permissions>admin.configuration.canManageOption</permissions>
			<icon>gear</icon>
			<showorder>100</showorder>
		</acpmenuitem>
	</import>

</data>
