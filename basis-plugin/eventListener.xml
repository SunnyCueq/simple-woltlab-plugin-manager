<?xml version="1.0" encoding="UTF-8"?>
<data xmlns="http://www.woltlab.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.woltlab.com http://www.woltlab.com/XSD/2019/eventListener.xsd">
	<import>
		<eventlistener name="shrinkrLinkAdd">
			<eventclassname>shrinkr\acp\form\ShrinkrLinkAddForm</eventclassname>
			<eventname>readFormParameters,assignVariables,save,readData</eventname>
			<listenerclassname>shrinkr\system\event\listener\ShrinkrLinkAddEventListener</listenerclassname>
			<inherit>1</inherit>
			<environment>admin</environment>
		</eventlistener>
		<eventlistener name="shrinkrLinkEditSpecialHint">
			<eventclassname>shrinkr\acp\form\ShrinkrLinkEditForm</eventclassname>
			<eventname>assignVariables</eventname>
			<listenerclassname>shrinkr\system\event\listener\ShrinkrLinkEditFormSpecialHintListener</listenerclassname>
			<environment>admin</environment>
		</eventlistener>
		<eventlistener name="shrinkrLinkEditCustomButtons">
			<eventclassname>shrinkr\acp\form\ShrinkrLinkAddForm</eventclassname>
			<eventname>assignVariables</eventname>
			<listenerclassname>shrinkr\system\event\listener\ShrinkrLinkEditCustomButtonsListener</listenerclassname>
			<environment>admin</environment>
		</eventlistener>
		<eventlistener name="discountFormRemoveSpecialFields">
			<eventclassname>shrinkr\acp\form\DiscountAddForm</eventclassname>
			<eventname>createForm</eventname>
			<listenerclassname>shrinkr\system\event\listener\DiscountFormListener</listenerclassname>
			<environment>admin</environment>
		</eventlistener>
		<eventlistener name="discountEditFormRemoveSpecialFields">
			<eventclassname>shrinkr\acp\form\DiscountEditForm</eventclassname>
			<eventname>createForm</eventname>
			<listenerclassname>shrinkr\system\event\listener\DiscountFormListener</listenerclassname>
			<environment>admin</environment>
		</eventlistener>
		<eventlistener name="acpHeaderBeforeDisplay">
			<eventclassname>wcf\system\template\TemplateEngine</eventclassname>
			<eventname>beforeDisplay</eventname>
			<listenerclassname>shrinkr\system\event\listener\AcpHeaderBeforeDisplayListener</listenerclassname>
			<environment>admin</environment>
		</eventlistener>
		<eventlistener name="userActionGuestReactionSync">
			<eventclassname>wcf\data\user\UserAction</eventclassname>
			<eventname>finalizeAction</eventname>
			<listenerclassname>shrinkr\system\event\listener\UserActionGuestReactionSyncListener</listenerclassname>
		</eventlistener>
		<eventlistener name="reactionActionGuestReaction">
			<eventclassname>wcf\data\reaction\ReactionAction</eventclassname>
			<eventname>validateAction,finalizeAction</eventname>
			<listenerclassname>shrinkr\system\event\listener\ReactionActionGuestReactionListener</listenerclassname>
		</eventlistener>
		<eventlistener name="optionActionDemoData">
			<eventclassname>wcf\data\option\OptionAction</eventclassname>
			<eventname>finalizeAction</eventname>
			<listenerclassname>shrinkr\system\event\listener\OptionActionDemoDataListener</listenerclassname>
			<environment>admin</environment>
		</eventlistener>
		<eventlistener name="optionFormDemoData">
			<eventclassname>wcf\acp\form\OptionForm</eventclassname>
			<eventname>saved</eventname>
			<listenerclassname>shrinkr\system\event\listener\OptionFormDemoDataListener</listenerclassname>
			<environment>admin</environment>
		</eventlistener>
	</import>

	<delete>
		<eventlistener name="urlAdd"/>
		<eventlistener name="urlEditSpecialHint"/>
		<eventlistener name="urlEditCustomButtons"/>
	</delete>
</data>
