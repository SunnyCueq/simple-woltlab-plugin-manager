<?xml version="1.0" encoding="UTF-8"?>
<!--
    Datei-Zweck: Template Listener Registration für Shr1nkr Plugin
    
    Diese XML-Datei registriert Template Listener für verschiedene Templates
    im WoltLab Framework. Die Listener werden automatisch beim Plugin-Installation
    geladen und aktiviert.
    
    Struktur:
    - <import>: Importiert Template Listener für das Plugin
    - <templatelistener>: Definiert Template Listener für spezifische Templates/Events
    
    Template Listener:
    1. shrinkrACPCSS: Lädt ACP-Stylesheet für spezifische Templates
    2. shrinkrOptionFormReloadLink: Fügt Reload-Button zu Option-Formular hinzu
    3. acpHeaderReactionTypesAfterFirstScript: Definiert REACTION_TYPES für ACP
    4. shrinkrAcpStylesheet: Lädt ACP-Stylesheet global
    5. shrinkrRequirePaths: Definiert Require-Pfade für JavaScript-Module
    6. shrinkrLinkListPageReaction: Lädt Reaction-Daten für URL-Liste
    7. shrinkrLinkAddLinkTitle: Fügt Link-Titel-Feld zu URL-Formular hinzu
    8. shrinkrLinkEditCustomButtons: Lädt Custom Buttons für URL-Bearbeitung
    9. shrinkrLinkEditFeaturedLinks: Lädt Featured Links für URL-Bearbeitung
    10. shrinkrLinkEditFormSpecialHint: Zeigt Hinweis zu vorhandenen Specials
    11. redirectReactionButton: Fügt Reaction-Button zu Redirect-Seite hinzu
    12. redirectCopyright: Fügt Copyright zu Redirect-Seite hinzu
    13. redirectEffect: Fügt visuelle Effekte (Snow, Ghosts, Autumn Leaves) hinzu
    
    @author Sunny C
    @copyright 2026 Sunny C
    @package de.sunnyc.wsc.shrinkr
    @see https://sunnyc.de
-->
<data xmlns="http://www.woltlab.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.woltlab.com http://www.woltlab.com/XSD/6.0/templateListener.xsd">
	<import>
		<!-- admin -->
		<templatelistener name="shrinkrACPCSS">
			<environment>admin</environment>
			<templatename>header</templatename>
			<eventname>stylesheets</eventname>
			<templatecode><![CDATA[{if ($templateName == "shrinkrLinkList" || $templateName == "descriptionAdd" || $templateName == "descriptionEdit") && $__shrinkr->isActiveApplication()}<link rel="stylesheet" type="text/css" href="{unsafe:$__wcf->getPath('shrinkr')}acp/style/shrinkr.css" />{/if}]]></templatecode>
		</templatelistener>

		<templatelistener name="shrinkrOptionFormReloadLink">
			<environment>admin</environment>
			<templatename>option</templatename>
			<eventname>javascriptInclude</eventname>
			<templatecode><![CDATA[{include file='__shrinkrOptionReloadButton' application='shrinkr'}]]></templatecode>
		</templatelistener>


		<templatelistener name="acpHeaderReactionTypesAfterFirstScript">
			<environment>admin</environment>
			<templatename>header</templatename>
			<eventname>stylesheets</eventname>
			<templatecode><![CDATA[{if MODULE_LIKE}
<script data-eager="true">
	// Define REACTION_TYPES directly after the first script block, but BEFORE WebComponent.min.js
	// This follows the same pattern as the frontend (headIncludeJavaScript.tpl)
	// The script with data-eager="true" is executed immediately, before WebComponent.min.js loads
	{if $reactionTypesJS|isset}
		var REACTION_TYPES = {unsafe:$reactionTypesJS};
	{else}
		// Fallback: Load directly from ReactionHandler if variable not set
		var REACTION_TYPES = {unsafe:$__wcf->getReactionHandler()->getReactionsJSVariable()};
	{/if}
</script>
{/if}]]></templatecode>
			<nice>1000</nice>
		</templatelistener>

		<templatelistener name="shrinkrAcpStylesheet">
			<environment>admin</environment>
			<templatename>header</templatename>
			<eventname>stylesheets</eventname>
			<templatecode><![CDATA[<link rel="stylesheet" type="text/css" href="{unsafe:$__wcf->getPath('shrinkr')}acp/style/shrinkr.css" />]]></templatecode>
		</templatelistener>

		<templatelistener name="shrinkrRequirePaths">
			<environment>admin</environment>
			<templatename>header</templatename>
			<eventname>requirePaths</eventname>
			<templatecode><![CDATA["d3": "{unsafe:$__wcf->getPath('shrinkr')}js/3rdParty/d3/d3.min",
				"topojson-client": "{unsafe:$__wcf->getPath('shrinkr')}js/3rdParty/topojson-client/topojson-client",]]></templatecode>
		</templatelistener>

		<!-- Copyright-Erweiterung -->
		<templatelistener name="shrinkrCopyright">
			<environment>user</environment>
			<templatename>pageFooterCopyright</templatename>
			<eventname>copyright</eventname>
			<templatecode><![CDATA[{include file='__shrinkrCopyright' application='shrinkr'}]]></templatecode>
		</templatelistener>

		<!-- Reaction Button für Redirect-Seite -->
		<templatelistener name="reactionButtonShrinkr">
			<environment>user</environment>
			<templatename>__redirectContainer</templatename>
			<eventname>beforeRedirectCopyright</eventname>
			<templatecode><![CDATA[{include file='__reactionButton' application='shrinkr'}]]></templatecode>
			<nice>2</nice>
		</templatelistener>

	</import>

</data>
