<?xml version="1.0" encoding="UTF-8"?>
<data xmlns="http://www.woltlab.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.woltlab.com http://www.woltlab.com/XSD/templatelistener.xsd">
	<import>
		<!-- admin -->
		<templatelistener name="shopOrderCSS">
			<environment>admin</environment>
			<templatename>header</templatename>
			<eventname>stylesheets</eventname>
			<templatecode><![CDATA[{if ($templateName == "urlList") && $__urlshort->isActiveApplication()}<link rel="stylesheet" type="text/css" href="{@$__wcf->getPath('urlshort')}acp/style/urlshort.css" />{/if}]]></templatecode>
		</templatelistener>

		<templatelistener name="urlshortCopyrightACP">
			<environment>admin</environment>
			<templatename>pageFooter</templatename>
			<eventname>copyright</eventname>
			<templatecode>
				<![CDATA[{if $__urlshort->isActiveApplication()}{include application='urlshort' file='__urlshortCopyright'}{/if}]]>
			</templatecode>
		</templatelistener>

        <!-- user -->
		<templatelistener name="urlshortCopyright">
			<environment>user</environment>
			<templatename>pageFooterCopyright</templatename>
			<eventname>copyright</eventname>
			<templatecode>
				<![CDATA[{if $__urlshort->isActiveApplication()}{include application='urlshort' file='__urlshortCopyright'}{/if}]]>
			</templatecode>
		</templatelistener>
	</import>
</data>