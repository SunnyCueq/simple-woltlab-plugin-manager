<?xml version="1.0" encoding="UTF-8"?>
<data xmlns="http://www.woltlab.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.woltlab.com http://www.woltlab.com/XSD/6.0/cronjob.xsd">
	<import>
		<cronjob name="de.sunnyc.wsc.shrinkr.discountCountdownCleanup">
			<classname>shrinkr\system\cronjob\DiscountCountdownCleanupCronjob</classname>
			<description>Removes expired countdowns (2 days after expiration)</description>
			<description language="de">Entfernt abgelaufene Countdowns (2 Tage nach Ablauf)</description>
			<expression>30 3 * * *</expression>
		</cronjob>
	</import>

	<delete>
		<cronjob name="de.sunnyc.wsc.shrinkr.discountCountdownCleanup"/>
	</delete>
</data>
