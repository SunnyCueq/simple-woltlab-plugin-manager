<?xml version="1.0" encoding="UTF-8"?>
<!--
    Datei-Zweck: Cronjob-Registration für Shr1nkr Plugin
    
    Diese XML-Datei registriert Cronjobs für das Shr1nkr Plugin.
    Definiert automatische Aufgaben die regelmäßig ausgeführt werden.
    
    Struktur:
    - <import>: Importiert Cronjobs für das Plugin
    - <cronjob>: Definiert einzelne Cronjobs mit Klasse, Beschreibung, Zeitplan
    - <delete>: Definiert Cronjobs die beim Deinstallieren entfernt werden
    
    Cronjobs:
    1. discountCountdownCleanup: Entfernt abgelaufene Countdowns (2 Tage nach Ablauf)
       - Zeitplan: 30 3 * * * (täglich um 3:30 Uhr)
       - Klasse: shrinkr\system\cronjob\DiscountCountdownCleanupCronjob
    2. statisticAggregation: Aggregiert Statistik-Daten täglich
       - Zeitplan: 2:05 Uhr
       - Klasse: wcf\system\cronjob\StatisticAggregationCronjob
    3. statisticCleanup: Löscht alte Statistik-Rohdaten
       - Zeitplan: 3:30 Uhr
       - Klasse: wcf\system\cronjob\StatisticCleanupCronjob
    
    @author Sunny C
    @copyright 2026 Sunny C
    @package de.sunnyc.wsc.shrinkr
    @see https://sunnyc.de
-->
<data xmlns="http://www.woltlab.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.woltlab.com http://www.woltlab.com/XSD/6.0/cronjob.xsd">
	<import>
		<cronjob name="de.sunnyc.wsc.shrinkr.discountCountdownCleanup">
			<classname>shrinkr\system\cronjob\DiscountCountdownCleanupCronjob</classname>
			<description>Removes expired countdowns (2 days after expiration)</description>
			<description language="de">Entfernt abgelaufene Countdowns (2 Tage nach Ablauf)</description>
			<expression>30 3 * * *</expression>
		</cronjob>
		
	<cronjob name="de.sunnyc.wsc.shrinkr.statisticAggregation">
		<classname>wcf\system\cronjob\StatisticAggregationCronjob</classname>
		<description language="de">Aggregiert Statistik-Daten täglich</description>
		<description language="en">Aggregates statistic data daily</description>
		<expression>5 2 * * *</expression>
	</cronjob>
	
	<cronjob name="de.sunnyc.wsc.shrinkr.statisticCleanup">
		<classname>wcf\system\cronjob\StatisticCleanupCronjob</classname>
		<description language="de">Löscht alte Statistik-Rohdaten</description>
		<description language="en">Cleans up old raw statistic data</description>
		<expression>30 3 * * *</expression>
	</cronjob>
	</import>
</data>
