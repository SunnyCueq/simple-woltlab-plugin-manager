<?xml version="1.0" encoding="UTF-8"?>
<data xmlns="http://www.woltlab.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.woltlab.com http://www.woltlab.com/XSD/6.0/page.xsd">
	<import>
		<page identifier="de.sunnyc.wsc.shrinkr.redirect">
			<pageType>system</pageType>
			<controller>shrinkr\page\RedirectPage</controller>
			<controllerCustomURL>r</controllerCustomURL>
			<name language="de">Shr1nkr: Weiterleitung</name>
			<name language="en">Shr1nkr: Redirect</name>
			<options>shrinkr_active</options>
			<allowSpidersToIndex>0</allowSpidersToIndex>
			<content language="en">
				<title>Redirect</title>
			</content>
			<content language="de">
				<title>Weiterleitung</title>
			</content>
		</page>
		
	<page identifier="de.sunnyc.wsc.shrinkr.acp.statistic">
		<pageType>system</pageType>
		<controller>shrinkr\acp\page\StatisticPage</controller>
		<name language="de">Shr1nkr: Statistiken</name>
		<name language="en">Shr1nkr: Statistics</name>
		<options>shrinkr_active,shrinkr_tracking_enabled</options>
		<permissions>admin.shrinkr.canViewStatistics</permissions>
		<content language="en">
			<title>Statistics</title>
		</content>
		<content language="de">
			<title>Statistiken</title>
		</content>
	</page>
	
	<page identifier="de.sunnyc.wsc.shrinkr.acp.statistic.info">
		<pageType>system</pageType>
		<controller>shrinkr\acp\page\StatisticInfoPage</controller>
		<name language="de">Shr1nkr: Statistik-Informationen</name>
		<name language="en">Shr1nkr: Statistics Information</name>
		<options>shrinkr_active</options>
		<permissions>admin.shrinkr.canViewStatistics</permissions>
		<content language="en">
			<title>Statistics Information</title>
		</content>
		<content language="de">
			<title>Statistik-Informationen</title>
		</content>
	</page>
	</import>

	<delete>
		<page identifier="de.sunnyc.wsc.shrinkr.redirect"/>
		<page identifier="de.sunnyc.wsc.shrinkr.Redirect"/>
	</delete>
</data>
