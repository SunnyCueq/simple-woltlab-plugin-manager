<?xml version="1.0" encoding="UTF-8"?>
<package name="info.benjaro.urlshort.affiliate" xmlns="https://www.woltlab.com" xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://www.woltlab.com https://www.woltlab.com/XSD/6.0/package.xsd">
	<packageinformation>
		<packagename>URL Shortener: Affiliate System</packagename>
		<packagename language="de">URL-Shortener: Affiliate-System</packagename>
		<packagedescription>Comprehensive affiliate system with discounts, themes, descriptions and featured links for the redirect page.</packagedescription>
		<packagedescription language="de">Umfassendes Affiliate-System mit Rabatten, Themes, Beschreibungen und Featured Links für die Weiterleitungsseite.</packagedescription>
		<version>1.0.741</version>
        <date>2025-12-23</date>
		<packageurl><![CDATA[https://benjaro.info]]></packageurl>
	</packageinformation>

	<authorinformation>
        <author>Benjaro</author>
        <authorurl>https://benjaro.info</authorurl>
	</authorinformation>

	<requiredpackages>
		<requiredpackage minversion="6.0.16">com.woltlab.wcf</requiredpackage>
		<requiredpackage minversion="6.0.0">dev.tkirch.wsc.urlshort</requiredpackage>
	</requiredpackages>

	<excludedpackages>
		<excludedpackage version="6.1.0 Alpha 1">com.woltlab.wcf</excludedpackage>
	</excludedpackages>

	<instructions type="install">
		<!-- files -->
		<instruction type="file"/>
		<instruction type="fileDelete" application="urlshort">fileDelete_three.xml</instruction>
		<instruction type="file" application="urlshort">files_urlshort.tar</instruction>
		<instruction type="file" application="wcf">files_wcf.tar</instruction>
        <instruction type="template" application="urlshort">templates_urlshort.tar</instruction>
        <instruction type="acpTemplate" application="urlshort">acptemplates_urlshort.tar</instruction>

        <instruction type="database" application="urlshort">acp/database/install_info.benjaro.urlshort.affiliate.php</instruction>

		<!-- xml-->
		<instruction type="option"/>
		<instruction type="templateListener"/>
		<instruction type="eventListener"/>
		<instruction type="language"/>
		<instruction type="objectType"/>
		<instruction type="acpMenu"/>
		<instruction type="userGroupOption"/>
		<instruction type="cronjob"/>

		<!-- post-install script -->
		<instruction type="script" application="urlshort">acp/install_info.benjaro.urlshort.affiliate_postInstall.php</instruction>
	</instructions>

	<instructions type="update" fromversion="*">
		<!-- files -->
		<instruction type="file"/>
		<instruction type="fileDelete" application="urlshort">fileDelete_three.xml</instruction>
		<instruction type="file" application="urlshort">files_urlshort.tar</instruction>
		<instruction type="file" application="wcf">files_wcf.tar</instruction>
        <instruction type="template" application="urlshort">templates_urlshort.tar</instruction>
        <instruction type="acpTemplate" application="urlshort">acptemplates_urlshort.tar</instruction>

		<!-- xml-->
		<instruction type="option"/>
		<instruction type="templateListener"/>
		<instruction type="eventListener"/>
		<instruction type="language"/>
		<instruction type="objectType"/>
		<instruction type="acpMenu"/>
		<instruction type="userGroupOption"/>
		<instruction type="cronjob"/>
	</instructions>

	<instructions type="uninstall">
		<!-- files -->
		<instruction type="file"/>
		<instruction type="fileDelete" application="urlshort">fileDelete_three.xml</instruction>
        <instruction type="file" application="urlshort">files_urlshort.tar</instruction>
        <instruction type="file" application="wcf">files_wcf.tar</instruction>
        <instruction type="template" application="urlshort">templates_urlshort.tar</instruction>
        <instruction type="acpTemplate" application="urlshort">acptemplates_urlshort.tar</instruction>

		<!-- xml-->
		<instruction type="option"/>
		<instruction type="templateListener"/>
		<instruction type="eventListener"/>
		<instruction type="language"/>
		<instruction type="objectType"/>
		<instruction type="acpMenu"/>
		<instruction type="userGroupOption"/>
		<instruction type="cronjob"/>

		<!-- database - runs AFTER uninstall script to remove tables -->
		<!-- NOTE: Uninstall script is automatically executed by WoltLab's PackageUninstallationDispatcher -->
		<!-- It must be located at: acp/uninstall/info.benjaro.urlshort.affiliate.php -->
		<instruction type="database" application="urlshort">acp/database/install_info.benjaro.urlshort.affiliate.php</instruction>
	</instructions>
</package>
