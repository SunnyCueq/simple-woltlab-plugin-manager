{
  "compilerOptions": {
    "target": "ES2020",
    "module": "AMD",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "rootDir": "_extracted/ts",
    "outDir": "_extracted/files/js",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "removeComments": false,
    "allowJs": true,
    "noEmit": false,
    "noEmitOnError": false,
    "typeRoots": [
      "node_modules/@types",
      "node_modules/@woltlab"
    ],
    "types": [],
    "baseUrl": ".",
    "paths": {
      "WoltLabSuite/*": ["node_modules/@woltlab/d.ts/WoltLabSuite/*"]
    }
  },
  "include": [
    "_extracted/ts/**/*",
    "_extracted/ts/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "_build_temp"
  ]
}

